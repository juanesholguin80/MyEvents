# Copia este archivo a ".env" (sin el ".example") y ajusta los valores.
# ".env" nunca se commitea (debe estar en .gitignore); este archivo sí, como plantilla documentada.

# --- Base de datos (Postgres) ---
# Usadas por el servicio "db" en docker-compose.yml para inicializar el contenedor de Postgres.
POSTGRES_USER=myevents
POSTGRES_PASSWORD=change-me
POSTGRES_DB=myevents

# Leída por app/core/config.py (Settings.DATABASE_URL) y usada por app/db/session.py para crear el engine de SQLAlchemy.
# Debe coincidir con POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB de arriba.
# Host "db": cuando el backend corre DENTRO de docker-compose (así se resuelve el nombre del servicio en la red interna).
# Host "localhost": si corres el backend fuera de Docker contra la BD expuesta en el puerto 5432 del host.
DATABASE_URL=postgresql+psycopg2://myevents:change-me@db:5432/myevents

# --- Autenticación (JWT) ---
# Secreto usado para firmar los tokens (core/security.py). Genera uno fuerte y aleatorio, nunca uses este valor en real.
# Ejemplo para generarlo: openssl rand -hex 32
JWT_SECRET_KEY=change-me
# Algoritmo de firma de los tokens (python-jose). HS256 es el estándar para secreto simétrico.
JWT_ALGORITHM=HS256
# Minutos de vida del access token.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Días de vida del refresh token.
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Logging ---
# Nivel de log para app/core/logging.py (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO

# --- Base de datos de pruebas (servicio "db_test" en docker-compose.yml) ---
# Usadas por el servicio "db_test" en docker-compose.yml para inicializar ese contenedor de Postgres
# (análogas a POSTGRES_USER/PASSWORD/DB de arriba, pero para la base de datos de test).
TEST_POSTGRES_USER=myevents_test
TEST_POSTGRES_PASSWORD=myevents_test
TEST_POSTGRES_DB=myevents_test

# Usada únicamente por tests/conftest.py (pytest), nunca por la app en ejecución.
# Es una base de datos Postgres aparte (puerto 5433) para no mezclar datos de test con los de desarrollo.
# Debe coincidir con TEST_POSTGRES_USER / TEST_POSTGRES_PASSWORD / TEST_POSTGRES_DB de arriba.
TEST_DATABASE_URL=postgresql+psycopg2://myevents_test:myevents_test@localhost:5433/myevents_test

# --- Metadata de la app (opcionales, tienen default en Settings) ---
# Usadas en la metadata de OpenAPI (main.py) si decides exponerlas ahí.
PROJECT_NAME=myevents
PROJECT_VERSION=0.0.1
